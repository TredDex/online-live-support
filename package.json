{
  "name": "online-live-support",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ols/server & npm run dev --workspace=@ols/web",
